---
interface Props {
	title?: string;
}

const { title = 'Workspace' } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#08090d" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-width: 320px;
		min-height: 100%;
	}

	body {
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			'Segoe UI', sans-serif;
		background: #08090d;
		color: #f5f7f8;
		overflow: hidden;
	}
</style>
