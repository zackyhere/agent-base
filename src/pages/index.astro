---
import Layout from '../layouts/Layout.astro';
import officeAvif from '../assets/office.avif';
import officeWebp from '../assets/office.webp';
---

<Layout title="Workspace">
	<main class="page">
		<!-- ────────────── CANVAS 70% ────────────── -->
		<section class="canvas" aria-label="Canvas gambar">
			<div class="canvas-viewport" id="canvas-viewport">
				<picture>
					<source srcset={officeAvif.src} type="image/avif" />
					<source srcset={officeWebp.src} type="image/webp" />
					<img
						class="canvas-image"
						id="canvas-image"
						src={officeWebp.src}
						alt="Canvas utama"
						draggable="false"
						width="2048"
						height="2048"
						decoding="async"
						fetchpriority="high"
					/>
				</picture>
			</div>

		</section>

		<!-- ────────────── CONTAINER 30% ────────────── -->
		<section class="bottom-container" aria-label="Daftar kartu">
			<div class="bottom-container-track">
				{Array.from({ length: 8 }).map(() => (
					<article class="card">
						<div class="skeleton card-image"></div>
						<div class="card-body">
							<span class="skeleton line card-title"></span>
							<span class="skeleton line card-subtitle"></span>
						</div>
					</article>
				))}
			</div>
		</section>

		<!-- ────────────── SIDEBAR (resizable) ────────────── -->
		<aside class="sidebar" id="sidebar" aria-label="Chat">
			<!-- ── Chat header ── -->
			<div class="chat-header">
				<button class="chat-sessions-btn" type="button" id="sessions-btn" aria-label="Lihat daftar session">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
				</button>
				<div class="chat-header-info">
					<span class="chat-room-name">Project Room</span>
				</div>
				<div class="chat-header-spacer"></div>
				<div class="header-switches" role="group" aria-label="Panel switches">
					<button class="switch-btn active" type="button" data-panel="chat" aria-label="Chat">1</button>
					<button class="switch-btn" type="button" data-panel="files" aria-label="Files">2</button>
					<button class="switch-btn" type="button" data-panel="search" aria-label="Search">3</button>
				</div>
			</div>

			<!-- ── Session list overlay ── -->
			<div class="sessions-panel" id="sessions-panel">
				<div class="sessions-header">
					<button class="sessions-close" type="button" id="sessions-close" aria-label="Tutup">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
					</button>
					<span class="sessions-title">Chat Sessions</span>
				</div>
				<div class="sessions-list">
					<div class="session-item active">
						<div class="session-avatar" style="background:#28cbb9;">P</div>
						<div class="session-info">
							<span class="session-name">Project Room</span>
							<span class="session-last">user2: keren banget hasilnya!</span>
						</div>
					</div>
					<div class="session-item">
						<div class="session-avatar" style="background:#7c5bf5;">D</div>
						<div class="session-info">
							<span class="session-name">Design Team</span>
							<span class="session-last">user1: mockup sudah ready</span>
						</div>
					</div>
					<div class="session-item">
						<div class="session-avatar" style="background:#f59e0b;">G</div>
						<div class="session-info">
							<span class="session-name">General</span>
							<span class="session-last">user3: meeting jam 3 ya</span>
						</div>
					</div>
				</div>
			</div>

			<!-- ── Chat messages ── -->
			<div class="chat-messages" id="chat-messages">
				<!-- user1 -->
				<div class="msg msg-other">
					<div class="msg-avatar" style="background:#7c5bf5;">A</div>
					<div class="msg-content">
						<span class="msg-name" style="color:#7c5bf5;">user1</span>
						<div class="msg-bubble">Halo semua, udah liat design barunya? 👀</div>
						<span class="msg-time">09:14</span>
					</div>
				</div>

				<!-- user2 -->
				<div class="msg msg-other">
					<div class="msg-avatar" style="background:#f59e0b;">B</div>
					<div class="msg-content">
						<span class="msg-name" style="color:#f59e0b;">user2</span>
						<div class="msg-bubble">Belum nih, yang mana?</div>
						<span class="msg-time">09:15</span>
					</div>
				</div>

				<!-- me -->
				<div class="msg msg-me">
					<div class="msg-content">
						<div class="msg-bubble">Ini gw udah push ke branch dev. Coba cek canvas-nya, udah bisa zoom & pan sekarang 🚀</div>
						<span class="msg-time">09:16</span>
					</div>
				</div>

				<!-- user1 -->
				<div class="msg msg-other">
					<div class="msg-avatar" style="background:#7c5bf5;">A</div>
					<div class="msg-content">
						<span class="msg-name" style="color:#7c5bf5;">user1</span>
						<div class="msg-bubble">Wih mantap, smooth banget gesture-nya. Sidebar bisa di-resize juga ya?</div>
						<span class="msg-time">09:18</span>
					</div>
				</div>

				<!-- me -->
				<div class="msg msg-me">
					<div class="msg-content">
						<div class="msg-bubble">Iya, drag resizer-nya aja. Auto zoom juga ngikutin 👍</div>
						<span class="msg-time">09:19</span>
					</div>
				</div>

				<!-- user3 -->
				<div class="msg msg-other">
					<div class="msg-avatar" style="background:#ef4444;">C</div>
					<div class="msg-content">
						<span class="msg-name" style="color:#ef4444;">user3</span>
						<div class="msg-bubble">Keren sih ini. Bottom container buat apa btw?</div>
						<span class="msg-time">09:21</span>
					</div>
				</div>

				<!-- me -->
				<div class="msg msg-me">
					<div class="msg-content">
						<div class="msg-bubble">Nanti itu buat nampung list assets/layer. Masih skeleton dulu sekarang ✌️</div>
						<span class="msg-time">09:22</span>
					</div>
				</div>

				<!-- user2 -->
				<div class="msg msg-other">
					<div class="msg-avatar" style="background:#f59e0b;">B</div>
					<div class="msg-content">
						<span class="msg-name" style="color:#f59e0b;">user2</span>
						<div class="msg-bubble">keren banget hasilnya! gas terus 💪</div>
						<span class="msg-time">09:24</span>
					</div>
				</div>
			</div>

			<!-- ── Chat input ── -->
			<div class="chat-input-row">
				<textarea class="chat-input" id="chat-input" placeholder="Ketik pesan..." autocomplete="off" rows="1"></textarea>
				<button class="chat-send-btn" type="button" id="chat-send" aria-label="Kirim pesan">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
				</button>
			</div>
		</aside>

		<!-- ────────────── RESIZER HOLD ────────────── -->
		<div class="resizer" id="resizer" role="separator" aria-orientation="vertical" aria-label="Geser untuk mengubah lebar sidebar" tabindex="0">
			<div class="resizer-handle"></div>
		</div>
	</main>
</Layout>

<script>
	// ──────────────────────────────────────────────
	//  Zoom & Pan logic untuk canvas
	// ──────────────────────────────────────────────
	const viewport = document.getElementById('canvas-viewport')!;
	const image = document.getElementById('canvas-image') as HTMLImageElement;

	const MAX_SCALE = 8;

	// Cache viewport dimensions — dibaca sekali, diupdate hanya saat ResizeObserver
	let vw = viewport.clientWidth;
	let vh = viewport.clientHeight;

	function updateViewportDims() {
		vw = viewport.clientWidth;
		vh = viewport.clientHeight;
	}

	function isZoomLocked() {
		return currentLayout === 'fit' || currentLayout === 'full';
	}

	let scale = 1;
	let tx = 0;
	let ty = 0;
	let pointers = new Map<number, { x: number; y: number }>();
	let lastPinchDist = 0;
	let isPanning = false;
	let isPinching = false;
	let panStart = { x: 0, y: 0 };

	// Layout mode: 'free' (1), 'fit' (2), atau 'full' (3)
	let currentLayout: 'free' | 'fit' | 'full' = 'free';

	const root = document.documentElement;
	const resizer = document.getElementById('resizer')!;

	const SB_MIN = 200;
	const SB_MAX = 560;
	const SB_DEFAULT = 340;
	const MOBILE_BP = 700;
	const SNAP_THRESHOLD = 80; // di bawah ini saat drag selesai, snap ke 0 (collapsed)

	function isMobile() {
		return window.innerWidth <= MOBILE_BP;
	}

	function getMinSidebarWidth() {
		return isMobile() ? 0 : SB_MIN;
	}

	// Track sidebar width secara in-memory, hindari getComputedStyle berulang
	let currentSBW = parseFloat(localStorage.getItem('sidebar-w') || '') || SB_DEFAULT;
	const sbMin = getMinSidebarWidth();
	if (currentSBW < sbMin || currentSBW > SB_MAX) currentSBW = SB_DEFAULT;

	// Simpan lebar sidebar terakhir saat masih terbuka (untuk toggle dblclick)
	let lastOpenSBW = currentSBW > 0 ? currentSBW : SB_DEFAULT;

	// Set sidebar width dari localStorage SECEPATNYA agar viewport.clientWidth akurat
	// saat initScale() dipanggil di bawah.
	// Matikan transition saat inisialisasi agar canvas tidak mid-transition
	// saat initScale() membaca viewport.clientWidth.
	document.body.classList.add('no-init-transition');
	root.style.setProperty('--sidebar-w', `${currentSBW}px`);
	document.body.classList.toggle('sb-collapsed', currentSBW === 0);

	// Dimensi natural gambar (ukuran asli piksel)
	function getRenderedSize() {
		const w = image.naturalWidth || image.clientWidth || 1;
		const h = image.naturalHeight || image.clientHeight || 1;
		return { w, h };
	}

	function getMinScale() {
		const { w, h } = getRenderedSize();
		return Math.max(vw / w, vh / h);
	}

	// Batasi posisi (tx, ty) agar seluruh viewport tetap terisi gambar (no black bars)
	// Gambar memiliki width/height = natural size (set via syncImageSize),
	// lalu transform scale memperbesar/mengecilkan. Range geser dihitung dari
	// kelebihan ukuran gambar ter-scaled terhadap viewport.
	function clampPan() {
		const { w, h } = getRenderedSize();
		const iw = w * scale;
		const ih = h * scale;

		// Gambar di-anchor di (0,0) dengan transform-origin: 0 0.
		// tx/ty harus di-clamp agar gambar selalu menutupi viewport:
		//   - Batas atas/kiri: tx/ty maksimal 0 (gambar tidak boleh bergeser ke kanan/bawah dari origin)
		//   - Batas bawah/kanan: tx/ty minimal -(iw - vw) agar tepi kanan/bawah gambar tidak masuk viewport
		if (iw <= vw) {
			tx = (vw - iw) / 2;
		} else {
			tx = Math.min(0, Math.max(-(iw - vw), tx));
		}

		if (ih <= vh) {
			ty = (vh - ih) / 2;
		} else {
			ty = Math.min(0, Math.max(-(ih - vh), ty));
		}
	}

	function apply() {
		clampPan();
		image.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
	}

	// Set style width/height gambar ke natural size (tanpa CSS sizing)
	function syncImageSize() {
		const { w, h } = getRenderedSize();
		if (w > 1 && h > 1) {
			image.style.width = `${w}px`;
			image.style.height = `${h}px`;
		}
	}

	function setScale(next: number, originX?: number, originY?: number) {
		const prev = scale;
		const minS = getMinScale();
		next = Math.min(MAX_SCALE, Math.max(minS, next));
		if (next === prev) return;
		const cx = originX ?? vw / 2;
		const cy = originY ?? vh / 2;
		const imgX = cx - tx;
		const imgY = cy - ty;
		const ratio = next / prev;
		tx = cx - imgX * ratio;
		ty = cy - imgY * ratio;
		scale = next;
		apply();
	}

	viewport.addEventListener('wheel', (e) => {
		if (isZoomLocked()) return;
		e.preventDefault();
		const rect = viewport.getBoundingClientRect();
		const x = e.clientX - rect.left;
		const y = e.clientY - rect.top;
		const delta = -e.deltaY * 0.0015;
		setScale(scale * (1 + delta), x, y);
	}, { passive: false });

	viewport.addEventListener('pointerdown', (e) => {
		if (isZoomLocked()) return;
		viewport.setPointerCapture(e.pointerId);
		pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
		if (pointers.size === 1) {
			isPanning = true;
			panStart = { x: e.clientX, y: e.clientY };
		} else if (pointers.size === 2) {
			isPanning = false;
			isPinching = true;
			const pts = [...pointers.values()];
			lastPinchDist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
		}
	});

	viewport.addEventListener('pointermove', (e) => {
		if (isZoomLocked()) return;
		if (!pointers.has(e.pointerId)) return;
		pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

		if (isPinching && pointers.size >= 2) {
			const pts = [...pointers.values()];
			const dist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
			if (lastPinchDist > 0) {
				const ratio = dist / lastPinchDist;
				const midX = (pts[0].x + pts[1].x) / 2;
				const midY = (pts[0].y + pts[1].y) / 2;
				const rect = viewport.getBoundingClientRect();
				setScale(scale * ratio, midX - rect.left, midY - rect.top);
			}
			lastPinchDist = dist;
			return;
		}

		if (isPanning && pointers.size === 1) {
			const dx = e.clientX - panStart.x;
			const dy = e.clientY - panStart.y;
			tx += dx;
			ty += dy;
			panStart = { x: e.clientX, y: e.clientY };
			apply();
		}
	});

	function endPointer(e: PointerEvent) {
		pointers.delete(e.pointerId);
		if (pointers.size < 2) { isPinching = false; lastPinchDist = 0; }
		if (pointers.size === 0) { isPanning = false; }
		if (pointers.size === 1) {
			const p = [...pointers.values()][0];
			panStart = { x: p.x, y: p.y };
			isPanning = true;
		}
	}
	viewport.addEventListener('pointerup', endPointer);
	viewport.addEventListener('pointercancel', endPointer);
	viewport.addEventListener('pointerleave', endPointer);

	// Set skala awal: zoom langsung ke "cover" agar tidak ada black bars
	function initScale() {
		syncImageSize();
		updateViewportDims();
		const { w, h } = getRenderedSize();
		let minS = Math.max(vw / w, vh / h);
		scale = minS;
		tx = (vw - w * minS) / 2;
		ty = (vh - h * minS) / 2;
		apply();
	}

	function safeInit() {
		const { w, h } = getRenderedSize();
		if (w < 2 || h < 2) {
			requestAnimationFrame(safeInit);
			return;
		}
		initScale();
		// Inisialisasi selesai — kembalikan transition untuk interaksi normal.
		// Gunakan double-rAF agar layout sudah flush dengan nilai sidebar final.
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				document.body.classList.remove('no-init-transition');
			});
		});
	}

	if (image.complete && image.naturalWidth > 0) {
		requestAnimationFrame(safeInit);
	} else {
		image.addEventListener('load', () => {
			requestAnimationFrame(safeInit);
		}, { once: true });
	}

	let roPending = false;
	const ro = new ResizeObserver(() => {
		if (roPending) return;
		roPending = true;
		requestAnimationFrame(() => {
			roPending = false;
			updateViewportDims();
			syncImageSize();
			handleResize();
		});
	});

	function handleResize() {
		if (currentLayout === 'fit') {
			// Di mode fit: gambar utuh (contain)
			const { w: imgW, h: imgH } = getRenderedSize();
			const canvasH = vh;

			if (currentLayout === 'fit') {
				// Mode fit: sidebar melebar hingga mepet canvas (no black bars)
				const containScale = canvasH / imgH;
				const renderedW = imgW * containScale;
				let sidebarW = Math.round(window.innerWidth - renderedW);
				sidebarW = Math.max(200, sidebarW);
				root.style.setProperty('--sidebar-w', `${sidebarW}px`);
			}

			// Set ulang skala & posisi setelah sidebar/canvas berubah
			requestAnimationFrame(() => {
				updateViewportDims();
				scale = vh / imgH;
				const iw = imgW * scale;
				const ih = imgH * scale;
				tx = (vw - iw) / 2;
				ty = (vh - ih) / 2;
				image.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
			});
			return;
		}
		const minS = getMinScale();
		const prevScale = scale;

		// Jika berpindah dari mobile ke desktop dan sidebar = 0, kembalikan ke SB_MIN
		const minW = getMinSidebarWidth();
		if (currentSBW < minW) {
			currentSBW = minW;
			root.style.setProperty('--sidebar-w', `${currentSBW}px`);
			document.body.classList.toggle('sb-collapsed', currentSBW === 0);
		}

		// Selama resize maupun tidak: pertahankan zoom user,
		// hanya naikkan ke minScale jika viewport mengecil dan
		// scale user jatuh di bawah cover minimum (no black bars).
		if (scale < minS) {
			scale = minS;
		}

		// Pertahankan titik fokus kamera:
		// Hitung titik di gambar yang sedang berada di tengah viewport,
		// lalu setelah scale berubah, posisikan agar titik itu tetap di tengah.
		// Titik tengah viewport dalam koordinat gambar (sebelum scale berubah)
		const focusX = (vw / 2 - tx) / prevScale;
		const focusY = (vh / 2 - ty) / prevScale;
		// Posisikan ulang agar titik fokus tetap di tengah viewport
		tx = vw / 2 - focusX * scale;
		ty = vh / 2 - focusY * scale;

		apply();
	}
	ro.observe(viewport);

	// ──────────────────────────────────────────────
	//  Drag-to-scroll untuk bottom container track
	// ──────────────────────────────────────────────
	const track = document.querySelector('.bottom-container-track') as HTMLElement | null;
	if (track) {
		let isDown = false;
		let startX = 0;
		let startScroll = 0;
		let hasMoved = false;

		track.addEventListener('pointerdown', (e) => {
			isDown = true;
			hasMoved = false;
			startX = e.clientX;
			startScroll = track.scrollLeft;
			track.setPointerCapture(e.pointerId);
			track.classList.add('dragging');
		});

		track.addEventListener('pointermove', (e) => {
			if (!isDown) return;
			const dx = e.clientX - startX;
			if (Math.abs(dx) > 4) hasMoved = true;
			track.scrollLeft = startScroll - dx;
		});

		function endDrag(e: PointerEvent) {
			if (!isDown) return;
			isDown = false;
			track.classList.remove('dragging');
			if (track.hasPointerCapture(e.pointerId)) track.releasePointerCapture(e.pointerId);
		}
		track.addEventListener('pointerup', endDrag);
		track.addEventListener('pointercancel', endDrag);
		track.addEventListener('pointerleave', endDrag);

		// Cegah klik setelah drag
		track.addEventListener('click', (e) => {
			if (hasMoved) { e.preventDefault(); e.stopPropagation(); }
		}, { capture: true });

		// Wheel horizontal support (Shift + wheel)
		track.addEventListener('wheel', (e) => {
			if (e.shiftKey) {
				track.scrollLeft += e.deltaY;
				e.preventDefault();
			}
		}, { passive: false });
	}

	// ──────────────────────────────────────────────
	//  Sidebar resizer
	// ──────────────────────────────────────────────

	let resizing = false;
	let startX = 0;
	let startW = 0;

	resizer.addEventListener('pointerdown', (e) => {
		if (currentLayout === 'fit' || currentLayout === 'full') return;
		// Jika sidebar collapsed, jangan mulai drag — biarkan dblclick yang menangani
		if (document.body.classList.contains('sb-collapsed')) return;
		resizing = true;
		startX = e.clientX;
		startW = currentSBW;
		resizer.setPointerCapture(e.pointerId);
		document.body.classList.add('resizing');
	});

	resizer.addEventListener('pointermove', (e) => {
		if (!resizing) return;
		const delta = startX - e.clientX;
		const minW = getMinSidebarWidth();
		currentSBW = Math.min(SB_MAX, Math.max(minW, startW + delta));
		root.style.setProperty('--sidebar-w', `${currentSBW}px`);
		document.body.classList.toggle('sb-collapsed', currentSBW === 0);
	});

	function endResize(e: PointerEvent) {
		if (!resizing) return;
		resizing = false;
		document.body.classList.remove('resizing');
		if (resizer.hasPointerCapture(e.pointerId)) resizer.releasePointerCapture(e.pointerId);

		// Snap ke 0 jika di mobile dan sidebar ditarik sangat sempit
		if (isMobile() && currentSBW > 0 && currentSBW < SNAP_THRESHOLD) {
			// Simpan lebar sebelum snap hanya jika sebelumnya cukup lebar
			if (startW >= SNAP_THRESHOLD) lastOpenSBW = startW;
			currentSBW = 0;
			root.style.setProperty('--sidebar-w', '0px');
			document.body.classList.add('sb-collapsed');
		}

		// Update lastOpenSBW hanya jika sidebar masih terbuka & cukup lebar
		if (currentSBW >= SNAP_THRESHOLD) lastOpenSBW = currentSBW;

		localStorage.setItem('sidebar-w', String(currentSBW));
	}
	resizer.addEventListener('pointerup', endResize);
	resizer.addEventListener('pointercancel', endResize);

	// keyboard: left/right arrow
	resizer.addEventListener('keydown', (e) => {
		if (currentLayout === 'fit' || currentLayout === 'full') return;
		const minW = getMinSidebarWidth();
		if (e.key === 'ArrowLeft') { currentSBW = Math.min(SB_MAX, currentSBW + 16); root.style.setProperty('--sidebar-w', `${currentSBW}px`); e.preventDefault(); }
		else if (e.key === 'ArrowRight') { currentSBW = Math.max(minW, currentSBW - 16); root.style.setProperty('--sidebar-w', `${currentSBW}px`); e.preventDefault(); }
		else if (e.key === 'Home') { currentSBW = SB_DEFAULT; root.style.setProperty('--sidebar-w', `${currentSBW}px`); e.preventDefault(); }
		else if (e.key === 'Enter') { localStorage.setItem('sidebar-w', String(currentSBW)); }
	});

	// Double-click toggle: tutup/buka sidebar (khusus mobile)
	function toggleSidebar() {
		if (currentLayout === 'fit' || currentLayout === 'full') return;
		if (currentSBW === 0) {
			// Buka kembali — pastikan minimal SB_MIN agar tidak nyaris 0
			currentSBW = Math.max(SB_MIN, lastOpenSBW);
			root.style.setProperty('--sidebar-w', `${currentSBW}px`);
			document.body.classList.remove('sb-collapsed');
			localStorage.setItem('sidebar-w', String(currentSBW));
		} else {
			// Tutup sidebar
			lastOpenSBW = currentSBW;
			currentSBW = 0;
			root.style.setProperty('--sidebar-w', '0px');
			document.body.classList.add('sb-collapsed');
			localStorage.setItem('sidebar-w', '0');
		}
	}

	resizer.addEventListener('dblclick', () => {
		if (!isMobile()) return;
		toggleSidebar();
	});

	// Saat collapsed, single tap juga bisa buka (lebih mudah di mobile)
	resizer.addEventListener('click', () => {
		if (!isMobile()) return;
		if (document.body.classList.contains('sb-collapsed')) {
			toggleSidebar();
		}
	});

	// ──────────────────────────────────────────────
	//  Session panel toggle
	// ──────────────────────────────────────────────
	const sessionsBtn = document.getElementById('sessions-btn')!;
	const sessionsPanel = document.getElementById('sessions-panel')!;
	const sessionsClose = document.getElementById('sessions-close')!;

	sessionsBtn.addEventListener('click', (e) => {
		e.stopPropagation();
		sessionsPanel.classList.toggle('open');
	});
	sessionsClose.addEventListener('click', () => {
		sessionsPanel.classList.remove('open');
	});

	// Tutup sessions panel saat klik di luar panel
	document.addEventListener('click', (e) => {
		if (!sessionsPanel.classList.contains('open')) return;
		if (sessionsPanel.contains(e.target as Node)) return;
		if (sessionsBtn.contains(e.target as Node)) return;
		sessionsPanel.classList.remove('open');
	});

	// Tutup sessions panel saat Escape
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && sessionsPanel.classList.contains('open')) {
		sessionsPanel.classList.remove('open');
		}
	});

	// ──────────────────────────────────────────────
	//  Switch buttons
	// ──────────────────────────────────────────────
	const switchBtns = document.querySelectorAll<HTMLButtonElement>('.switch-btn');

	function applyLayout(layout: 'free' | 'fit' | 'full') {
		currentLayout = layout;
		document.body.dataset.layout = layout;

		if (layout === 'fit') {
			// Tata letak 2: gambar utuh (contain), sidebar melebar hingga mepet canvas
			// agar tidak ada space blank hitam di canvas.
			const { w: imgW, h: imgH } = getRenderedSize();
			const canvasH = vh; // 70% dari 100dvh

			// containScale: gambar muat penuh dalam tinggi canvas
			const containScale = canvasH / imgH;
			const renderedW = imgW * containScale;

			// Sidebar = sisa lebar layar setelah gambar dirender (mepet ke canvas)
			let sidebarW = Math.round(window.innerWidth - renderedW);
			sidebarW = Math.max(200, sidebarW);
			// JANGAN timpa currentSBW — nilai ini adalah sidebar width user untuk mode free.
			// Di mode fit, sidebar width di-set langsung via CSS variable tanpa mengubah currentSBW.
			root.style.setProperty('--sidebar-w', `${sidebarW}px`);

			// Set ulang skala & posisi gambar setelah sidebar berubah
			// (viewport.clientWidth sudah terupdate setelah sidebar di-set)
			requestAnimationFrame(() => {
				updateViewportDims();
				// Gunakan vw/vh yang baru di-update, bukan closure value
				const fitScale = vh / imgH;
				scale = fitScale;
				const iw = imgW * scale;
				const ih = imgH * scale;
				tx = (vw - iw) / 2;
				ty = (vh - ih) / 2;
				image.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
			});
		} else if (layout === 'full') {
			// Tata letak 3: sidebar full screen, canvas & bottom container disembunyikan
			root.style.setProperty('--sidebar-w', '0px');
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					document.body.classList.remove('no-init-transition');
				});
			});
		} else {
			// Tata letak 1: kembalikan ke mode free (zoom/pan aktif)
			// currentSBW masih menyimpan nilai user yang asli (tidak ditimpa oleh mode fit)
			root.style.setProperty('--sidebar-w', `${currentSBW}px`);
			document.body.classList.toggle('sb-collapsed', currentSBW === 0);
			// Tunggu satu frame agar browser selesai re-render canvas & bottom-container
			// (yang baru saja display:none di mode full/fit) sebelum initScale()
			// membaca viewport.clientWidth.
			requestAnimationFrame(() => {
				initScale();
			});
		}
	}

	switchBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			switchBtns.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');

			const panel = btn.dataset.panel;
			if (panel === 'files') {
				applyLayout('fit');
			} else if (panel === 'search') {
				applyLayout('full');
			} else {
				applyLayout('free');
			}
		});
	});

	// ──────────────────────────────────────────────
	//  Chat send (demo)
	// ──────────────────────────────────────────────
	const chatInput = document.getElementById('chat-input') as HTMLTextAreaElement;
	const chatSend = document.getElementById('chat-send')!;
	const chatMessages = document.getElementById('chat-messages')!;

	// Ambil atribut data-astro-cid dari elemen yang sudah ada
	// agar elemen baru yang dibuat via JS juga kena scoped CSS
	const astroAttr = (() => {
		const existing = chatMessages.querySelector('.msg');
		if (!existing) return '';
		for (const attr of existing.attributes) {
			if (attr.name.startsWith('data-astro-cid')) return attr.name;
		}
		return '';
	})();

	function scopeEl(el: Element) {
		if (!astroAttr) return;
		el.setAttribute(astroAttr, '');
		el.querySelectorAll('*').forEach((child) => child.setAttribute(astroAttr, ''));
	}

	// Auto-resize textarea
	function autoResize() {
		chatInput.style.height = 'auto';
		chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
	}
	chatInput.addEventListener('input', autoResize);

	function escapeHtml(str: string) {
		return str
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;');
	}

	function sendMessage() {
		const text = chatInput.value.trim();
		if (!text) return;
		chatInput.value = '';
		chatInput.style.height = 'auto';

		const now = new Date();
		const time = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

		// Convert newlines to <br> for bubble display
		const html = escapeHtml(text).replace(/\n/g, '<br>');

		const msg = document.createElement('div');
		msg.className = 'msg msg-me';
		msg.innerHTML = `
			<div class="msg-content">
				<div class="msg-bubble">${html}</div>
				<span class="msg-time">${time}</span>
			</div>
		`;
		scopeEl(msg);
		chatMessages.appendChild(msg);
		chatMessages.scrollTop = chatMessages.scrollHeight;
	}

	chatSend.addEventListener('click', sendMessage);
	chatInput.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey) {
			e.preventDefault();
			sendMessage();
		}
		// Shift+Enter = newline (default textarea behavior, no action needed)
	});

	// Auto-scroll ke bawah saat load
	chatMessages.scrollTop = chatMessages.scrollHeight;
</script>

<style>
